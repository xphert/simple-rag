# Endpoint OpenAI-compatible (Groq, gateway, LiteLLM, dsb).
# Isi LLM_API_KEY + LLM_BASE_URL sesuai provider kamu.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gemini/gemini-3-flash-preview
LLM_TEMPERATURE=0.2

# Kompatibilitas dengan repo asli (dipakai bila LLM_API_KEY kosong).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Dipakai hanya jika tidak ada API key sama sekali (mode offline).
LLM_LOCAL_MODEL=models/Qwen2.5-1.5B-Instruct
